{
  "name": "capstone-express-orm",
  "version": "1.0.0",
  "description": "Capstone Express ORM - API Back End cho ứng dụng chia sẻ ảnh (Pinterest clone)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:up": "docker compose up -d",
    "prisma:pull": "prisma db pull",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "test": "node --test tests/api.test.js"
  },
  "engines": {
    "node": "20.x"
  },
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^7.10.0"
  }
}
